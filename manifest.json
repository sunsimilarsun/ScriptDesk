{
  "manifest_version": 3,
  "name": "ScriptDesk 小组件起始页",
  "key": "",
  "version": "2.8.5",
  "description": "浏览器端 Scriptable 风格小组件起始页：话费三环 + Codex/WorkBuddy 额度 + MoeRouter 中转余额 + IP 纯净度 + 汇率折线图 + RSS/GitHub/行情/网络",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "查看订阅余量"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
